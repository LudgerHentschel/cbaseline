cff-version: 1.2.0
title: "CBaseline"
message: "If you use CBaseline in academic work, please cite the supporting papers and repository."
type: software

authors:
  - family-names: "Hentschel"
    given-names: "Ludger"

repository-code: "https://github.com/LudgerHentschel/cbaseline"
license: "BSD-3-Clause"

keywords:
  - machine learning
  - interpretability
  - feature attribution
  - Integrated Gradients
  - Shapley values
  - SHAP
  - prediction-neutral backgrounds

abstract: >
  CBaseline constructs prediction-neutral empirical background distributions
  for feature attribution. It provides deterministic equal-weight backgrounds
  and kernel-weighted backgrounds calibrated to a user-specified reference
  prediction.

references:
  - type: generic
    authors:
      - family-names: "Hentschel"
        given-names: "Ludger"
    title: "Canonical Integrated Gradients: Expectations over Neutral Prediction Baselines"
    year: 2026
    url: "https://www.ludgerhentschel.com/PDFs/Hentschel%20'26h.pdf"
  - type: generic
    authors:
      - family-names: "Hentschel"
        given-names: "Ludger"
    title: "A Canonical Background Distribution for Shapley Attribution"
    year: 2026
    url: "https://www.ludgerhentschel.com/PDFs/Hentschel%20'26i.pdf"
